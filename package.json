{
  "name": "grief",
  "version": "1.6.0",
  "description": "GRIEF: tracker ligero de Valorant, League of Legends y TFT via API local del cliente de Riot, con perfiles de controles de Dota 2",
  "author": "IRIS Studio",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "start": "node src/cli.js",
    "watch": "node src/cli.js --watch",
    "ui": "node src/server.js",
    "app": "electron .",
    "dist": "electron-builder --win",
    "lol:debug": "node src/loldebug.js"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.estudioiris.grief",
    "productName": "GRIEF",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**",
      "src/**",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "GRIEF-Setup.${ext}"
    },
    "portable": {
      "artifactName": "GRIEF-Portable.${ext}"
    }
  }
}
