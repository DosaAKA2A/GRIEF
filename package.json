{
  "name": "grief",
  "version": "0.1.0",
  "description": "GRIEF: tracker ligero de Valorant via API local del cliente de Riot",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "start": "node src/cli.js",
    "watch": "node src/cli.js --watch",
    "ui": "node src/server.js",
    "app": "electron .",
    "configurar-dota": "node src/dotasetup.js",
    "dist": "electron-builder --win"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.estudioiris.grief",
    "productName": "GRIEF",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**",
      "src/**",
      "package.json"
    ],
    "win": {
      "target": ["nsis", "portable"],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    }
  }
}
